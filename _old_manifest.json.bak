{
  "manifest_version": 3,
  "name": "Job Matcher AI",
  "version": "1.0.0",
  "description": "Анализ вакансий и создание сопроводительных писем через Gemini AI.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "Открыть Job Matcher",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": [
      "background.js"
    ],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-matcher@ai-studio.local",
      "strict_min_version": "128.0"
    }
  }
}