{
  "manifest_version": 3,
  "name": "Job Matcher AI",
  "version": "2.0.0",
  "description": "Analyse von Stellenanzeigen und Erstellung von Anschreiben mit KI.",
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_title": "Job Matcher öffnen",
    "default_icon": "icon.png"
  },
  "background": {
    "scripts": ["background.js"]
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "host_permissions": [
    "http://localhost:11434/*",
    "http://127.0.0.1:11434/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*.stepstone.de/*",
    "https://*.stepstone.com/*",
    "https://*.linkedin.com/*",
    "https://*.monster.de/*",
    "https://*.monster.com/*",
    "https://*.indeed.com/*",
    "https://*.indeed.de/*",
    "https://*.xing.com/*",
    "https://*.arbeitsagentur.de/*",
    "https://*.heyjobs.co/*",
    "https://*.jobvector.de/*",
    "https://*.stellenanzeigen.de/*",
    "https://*.kimeta.de/*",
    "https://*.jobware.de/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "job-matcher@ai-studio.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
