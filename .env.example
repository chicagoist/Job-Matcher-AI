# ─────────────────────────────────────────────
# Job Matcher AI — Python CLI Configuration
# ─────────────────────────────────────────────
# Copy this file to .env and fill in your keys:
#   cp .env.example .env

# ── Job Provider: Adzuna ────────────────────
# Get free API keys at: https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_API_KEY=

# ── Job Provider: Indeed (optional) ─────────
# Indeed Partner API requires an official partnership.
# The Indeed Publisher Program has been paused since Oct 2022.
# INDEED_PUBLISHER_ID=

# ── Local LLM: Ollama ──────────────────────
# Install Ollama: https://ollama.com/
# Download model: ollama pull llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── Storage ─────────────────────────────────
# Path to SQLite database (supports ~ expansion)
JOB_MATCHER_DB=~/.job-matcher/data.db
