{
  "name": "job-matcher-ai",
  "version": "2.0.0",
  "description": "Stellen analysieren und Anschreiben automatisch erstellen – mit Gemini.",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf dist web-ext-artifacts",
    "lint:ext": "web-ext lint --source-dir=dist",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "node esbuild.config.mjs",
    "build:watch": "node esbuild.config.mjs --watch",
    "start": "npm run build && npx web-ext run",
    "package": "npm run build && web-ext build --source-dir=dist --artifacts-dir=web-ext-artifacts --overwrite-dest",
    "sign": "npm run build && web-ext sign --source-dir=dist --artifacts-dir=web-ext-artifacts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/firefox-webext-browser": "^120.0.4",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.14.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "web-ext": "^8.3.0"
  }
}
